# Public frontend configuration only. Never put secrets in this file.

# Base URL of the Express API (all HTTP calls go through src/api/apiClient.js)
VITE_API_BASE_URL=http://localhost:5000/api

# Socket.IO server URL (defaults to the API host without /api if omitted)
VITE_SOCKET_URL=http://localhost:5000

# 'true' = run against the built-in mock API (no backend needed).
# Set to 'false' once the backend team's API is running.
VITE_USE_MOCK_API=true

# 'true' = simulated notification events instead of a Socket.IO server.
# Defaults to the value of VITE_USE_MOCK_API.
VITE_USE_MOCK_SOCKET=true

# How the backend authenticates: 'token' (JWT in Authorization header) or 'cookie' (HttpOnly session cookie)
VITE_AUTH_MODE=token

# Token mode only: where to keep the token when "Remember me" is checked: 'local' or 'session'
VITE_AUTH_STORAGE=local

# Where the "Continue with Google" button sends the browser (backend starts the OAuth flow)
VITE_GOOGLE_AUTH_URL=http://localhost:5000/api/auth/google

# Repository opened by the footer GitHub icon
VITE_GITHUB_URL=https://github.com/sathiya0529/AI-Skill-Gap-Analyzer
